<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HiveMindMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/obsidian_bg</item>
        <item name="android:statusBarColor">@color/obsidian_bg</item>
        <item name="android:navigationBarColor">@color/obsidian_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <!-- windowLightNavigationBar exige API 27 e o minSdk é 26; a barra já
             é obsidian via navigationBarColor, então o item fica de fora. -->
        <item name="android:colorPrimary">@color/brand_gold</item>
        <item name="android:colorPrimaryDark">@color/obsidian_bg</item>
        <item name="android:colorAccent">@color/brand_gold_strong</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_body</item>
    </style>

    <style name="Theme.HiveMindMobile.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/obsidian_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/obsidian_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.HiveMindMobile</item>
        <item name="android:statusBarColor">@color/obsidian_bg</item>
        <item name="android:navigationBarColor">@color/obsidian_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
